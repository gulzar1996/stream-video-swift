+
+void VideoRtpTrackSource::OnFrame(const VideoFrame& frame) {
+  scoped_refptr<ReceivedVideoFrameProcessor> processor;
+  uint64_t generation;
+  {
+    MutexLock lock(&processor_mutex_);
+    if (processing_stopped_) return;
+    processor = processor_;
+    generation = processor_generation_;
+  }
+  if (!processor) {
+    broadcaster_.OnFrame(frame);
+    return;
+  }
+  processor->Process(frame,
+      [self = scoped_refptr<VideoRtpTrackSource>(this), generation](
+          const VideoFrame& output) {
+        {
+          MutexLock lock(&self->processor_mutex_);
+          if (self->processing_stopped_ ||
+              self->processor_generation_ != generation) return;
+        }
+        self->broadcaster_.OnFrame(output);
+      });
+}
+
+void VideoRtpTrackSource::UpdateProcessor(ReceivedVideoProcessorUpdate update) {
+  RTC_DCHECK_RUN_ON(&worker_sequence_checker_);
+  scoped_refptr<ReceivedVideoFrameProcessor> previous;
+  {
+    MutexLock lock(&processor_mutex_);
+    if (processing_stopped_) return;
+    previous = processor_;
+  }
+  auto next = update(previous);
+  {
+    MutexLock lock(&processor_mutex_);
+    if (processing_stopped_) {
+      if (next) next->Stop();
+      return;
+    }
+    ++processor_generation_;
+    processor_ = next;
+  }
+  if (previous && previous != next) previous->Stop();
+}
+
+void VideoRtpTrackSource::StopProcessing() {
+  scoped_refptr<ReceivedVideoFrameProcessor> previous;
+  {
+    MutexLock lock(&processor_mutex_);
+    processing_stopped_ = true;
+    ++processor_generation_;
+    previous = std::move(processor_);
+  }
+  if (previous) previous->Stop();
 }
 
